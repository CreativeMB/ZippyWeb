{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/login",
        "destination": "/login.html"
      },
      {
        "source": "/admin",
        "destination": "/index.html"
      },
      {
        "source": "/t/**",
        "destination": "/tienda.html"
      },
      {
        "source": "**",
        "destination": "/tienda.html"
      }
    ]
  }
}
